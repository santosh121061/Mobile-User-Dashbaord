        "primaryText": "#FFFFFF",
        "primaryPressedText": "#FFFFFF"
      },
      "canvas": "#F3F7FD",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EDF3FB",
      "text": {
        "primary": "#101A38",
        "secondary": "#586D8B",
        "tertiary": "#586D8B"
      },
      "border": "#E5ECF7",
      "divider": "#E5ECF7",
      "status": {
        "success": "#057A4E",
        "successSoft": "#E5FAF0",
        "successText": "#057A4E",
        "warning": "#9F6404",
        "warningSoft": "#FFF5DE",
        "warningText": "#9F6404",
        "danger": "#D83151",
        "dangerPressed": "#BC2444",
        "dangerSoft": "#FFF0F3",
        "dangerText": "#C22D49",
        "dangerButtonText": "#FFFFFF",
        "dangerPressedText": "#FFFFFF"
      },
      "accent": {
        "purple": "#7954D8",
        "purpleSoft": "#F1EDFF",
        "mint": "#079D76",
        "mintSoft": "#E3FAF3",
        "gold": "#B77A08",
        "goldSoft": "#FFF6DE",
        "slateIcon": "#586D8B",
        "chart": "#00A993"
      },
      "overlay": "rgba(19,40,67,0.27)",
      "controlBorder": "#6F85A8",
      "selectionOutline": "#B9C7DE",
      "searchIcon": "#6A82A8",
      "focus": "#1267FF",
      "inputSurface": "#F7FAFE",
      "inputBorder": "#9BACCA"
    },
    "dark": {
      "brand": {
        "primary": "#8EB6FF",
        "primaryFill": "#1D62E8",
        "primaryPressed": "#1957CD",
        "primarySoft": "#233B65",
        "primarySubtle": "#1B2A44",
        "primaryText": "#FFFFFF",
        "primaryPressedText": "#FFFFFF"
      },
      "canvas": "#0D1527",
      "surface": "#17223A",
      "surfaceMuted": "#22314C",
      "text": {
        "primary": "#F1F5FF",
        "secondary": "#A4B5D2",
        "tertiary": "#93A6C5"
      },
      "border": "#2B3A56",
      "divider": "#2B3A56",
      "status": {
        "success": "#63DDB1",
        "successSoft": "#143E35",
        "successText": "#63DDB1",
        "warning": "#F4CA7D",
        "warningSoft": "#433922",
        "warningText": "#F4CA7D",
        "danger": "#D83151",
        "dangerPressed": "#BC2444",
        "dangerSoft": "#452738",
        "dangerText": "#FFA0B5",
        "dangerButtonText": "#FFFFFF",
        "dangerPressedText": "#FFFFFF"
      },
      "accent": {
        "purple": "#C4AFFF",
        "purpleSoft": "#352B53",
        "mint": "#71DFBD",
        "mintSoft": "#173D37",
        "gold": "#F1C875",
        "goldSoft": "#443923",
        "slateIcon": "#A4B5D2",
        "chart": "#60D9BD"
      },
      "overlay": "rgba(19,40,67,0.55)",
      "controlBorder": "#6F85A8",
      "selectionOutline": "#B9C7DE",
      "searchIcon": "#6A82A8",
      "focus": "#8EB6FF",
      "inputSurface": "#1B2A44",
      "inputBorder": "#6F85A8"
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "sm": 11,
    "md": 13,
    "lg": 16,
    "full": 9999,
    "xs": 8,
    "xl": 20,
    "pill": 9999
  },
  "layout": {
    "breakpoints": {
      "compact": 600,
      "medium": 768,
      "expanded": 768,
      "kpiFourColumnsEligible": 900
    },
    "dimensions": {
      "appBarHeight": 64,
      "bottomTabBarHeight": 66,
      "navigationRailWidth": 88,
      "sidebarWidth": 88,
      "kpiCardMin": {
        "width": 120,
        "height": 88
      },
      "listItemMinHeight": 64,
      "searchFieldHeight": 46,
      "inputFieldHeight": 50
    },
    "breakpointPolicy": "Bottom navigation below600; reference navigation rail at600 and above; large text uses stacked layouts."
  },
  "interactive": {
    "minHitTarget": 48,
    "components": {
      "primaryButton": {
        "visualHeight": 48,
        "minHitTarget": 48,
        "radius": 11
      },
      "secondaryButton": {
        "visualHeight": 48,
        "minHitTarget": 48,
        "radius": 11
      },
      "inputField": {
        "visualHeight": 50,
        "minHitTarget": 48,
        "radius": 11
      },
      "searchField": {
        "visualHeight": 46,
        "minHitTarget": 48,
        "radius": 11
      },
      "filterChip": {
        "visualHeight": 34,
        "minHitTarget": 48,
        "radius": 9
      },
      "iconButton": {
        "visualSize": 40,
        "minHitTarget": 48,
        "radius": 11
      },
      "fab": {
        "visualSize": 56,
        "minHitTarget": 56,
        "radius": 9999
      }
    }
  },
  "shadows": {
    "elevation1": {
      "shadowColor": "#315894",
      "shadowOffset": {
        "width": 0,
        "height": 3
      },
      "shadowOpacity": 0.025,
      "shadowRadius": 8,
      "elevation": 1
    },
    "elevation2": {
      "shadowColor": "#0B1736",
      "shadowOffset": {
        "width": 0,
        "height": 4
      },
      "shadowOpacity": 0.08,
      "shadowRadius": 8,
      "elevation": 3
    },
    "elevation3": {
      "shadowColor": "#0B1736",
      "shadowOffset": {
        "width": 0,
        "height": 12
      },
      "shadowOpacity": 0.12,
      "shadowRadius": 16,
      "elevation": 6
    },
    "card": {
      "y": 4,
      "blur": 12,
      "spread": 0,
      "color": "rgba(15, 23, 42, 0.06)"
    },
    "floating": {
      "y": 8,
      "blur": 24,
      "color": "rgba(15, 23, 42, 0.12)"
    }
  },
  "motion": {
    "durationFast": 150,
    "durationNormal": 250,
    "durationSlow": 350,
    "easingDefault": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "zIndex": {
    "fab": 100,
    "dropdown": 200,
    "bottomSheet": 400,
    "modal": 500,
    "toast": 1000
  },
  "iconStrokeWidth": {
    "size24": 2.0,
    "size20": 1.75
  }
}
