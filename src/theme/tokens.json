{
  "name": "User Dashboard Mobile Design Tokens",
  "version": "2.3.0",
  "description": "Selected reference palette and typography with semantic control and text contrast retained.",
  "typography": {
    "fontFamily": "Inter",
    "bundledWeights": [
      {
        "name": "Regular",
        "weight": 400,
        "file": "Inter-Regular.ttf"
      },
      {
        "name": "Medium",
        "weight": 500,
        "file": "Inter-Medium.ttf"
      },
      {
        "name": "SemiBold",
        "weight": 600,
        "file": "Inter-SemiBold.ttf"
      },
      {
        "name": "Bold",
        "weight": 700,
        "file": "Inter-Bold.ttf"
      },
      {
        "name": "DemiBold",
        "weight": 650,
        "file": "Inter-DemiBold.ttf"
      },
      {
        "name": "ExtraBold",
        "weight": 750,
        "file": "Inter-ExtraBold-Optical15.ttf"
      }
    ],
    "scale": {
      "display": {
        "fontSize": 30,
        "lineHeight": 38,
        "fontWeight": "700"
      },
      "h1": {
        "fontSize": 26,
        "lineHeight": 34,
        "fontWeight": "700"
      },
      "greeting": {
        "fontSize": 26,
        "lineHeight": 34,
        "fontWeight": "700"
      },
      "h2": {
        "fontSize": 18,
        "lineHeight": 26,
        "fontWeight": "600"
      },
      "title": {
        "fontSize": 18,
        "lineHeight": 26,
        "fontWeight": "600"
      },
      "body": {
        "fontSize": 15,
        "lineHeight": 23,
        "fontWeight": "400"
      },
      "bodyMedium": {
        "fontSize": 15,
        "lineHeight": 22,
        "fontWeight": "600"
      },
      "button": {
        "fontSize": 15,
        "lineHeight": 22,
        "fontWeight": "600"
      },
      "caption": {
        "fontSize": 12,
        "lineHeight": 18,
        "fontWeight": "400"
      },
      "captionMedium": {
        "fontSize": 13,
        "lineHeight": 20,
        "fontWeight": "500"
      },
      "micro": {
        "fontSize": 12,
        "lineHeight": 18,
        "fontWeight": "500"
      },
      "secondary": {
        "fontSize": 13,
        "lineHeight": 20,
        "fontWeight": "400"
      },
      "appbar": {
        "fontSize": 22,
        "lineHeight": 30,
        "fontWeight": "600"
      },
      "metric": {
        "fontSize": 22,
        "lineHeight": 30,
        "fontWeight": "700"
      },
      "section": {
        "fontSize": 16,
        "lineHeight": 22,
        "fontWeight": "600"
      }
    }
  },
  "colors": {
    "light": {
      "brand": {
        "primary": "#0F5CE5",
