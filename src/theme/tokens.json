{
    "name": "User Dashboard Mobile Design Tokens",
    "version": "2.3.0",
    "description": "Canonical reviewed semantic tokens. Numeric contrast pairs checked; actual component/state/device accessibility remains pending.",
    "typography": {
        "fontFamily": "Inter",
        "bundledWeights": [
            {
                "name": "Regular",
                "weight": 400,
                "file": "Inter-Regular.ttf"
            },
            {
                "name": "Medium",
                "weight": 500,
                "file": "Inter-Medium.ttf"
            },
            {
                "name": "SemiBold",
                "weight": 600,
                "file": "Inter-SemiBold.ttf"
            }
        ],
        "scale": {
            "display": {
                "fontSize": 32,
                "lineHeight": 40,
                "fontWeight": "600"
            },
            "h1": {
                "fontSize": 28,
                "lineHeight": 36,
                "fontWeight": "600",
                "description": "Standalone full-page primary title"
            },
            "greeting": {
                "fontSize": 24,
                "lineHeight": 32,
                "fontWeight": "600",
                "description": "Dashboard greeting title"
            },
            "h2": {
                "fontSize": 22,
                "lineHeight": 30,
                "fontWeight": "600"
            },
            "title": {
                "fontSize": 18,
                "lineHeight": 26,
                "fontWeight": "500"
            },
            "body": {
                "fontSize": 14,
                "lineHeight": 22,
                "fontWeight": "400"
            },
            "bodyMedium": {
                "fontSize": 14,
                "lineHeight": 22,
                "fontWeight": "500"
            },
            "button": {
                "fontSize": 14,
                "lineHeight": 20,
                "fontWeight": "600"
            },
            "caption": {
                "fontSize": 12,
                "lineHeight": 18,
                "fontWeight": "400"
            },
            "captionMedium": {
                "fontSize": 12,
                "lineHeight": 18,
                "fontWeight": "500"
            },
            "micro": {
                "fontSize": 11,
                "lineHeight": 16,
                "fontWeight": "500"
            }
        }
    },
    "colors": {
        "light": {
            "brand": {
                "primary": "#0B5ED7",
                "primaryPressed": "#084298",
                "primarySoft": "#EAF3FF",
                "primarySubtle": "#F5F9FF",
                "primaryText": "#FFFFFF",
                "primaryPressedText": "#FFFFFF"
            },
            "canvas": "#F7FAFF",
            "surface": "#FFFFFF",
            "surfaceMuted": "#F3F7FC",
            "text": {
                "primary": "#0B1736",
                "secondary": "#52627A",
                "tertiary": "#5C6B82"
            },
            "border": "#DCE7F4",
            "divider": "#E8EEF7",
            "status": {
                "success": "#0B6E3F",
                "successSoft": "#ECFDF3",
                "successText": "#0B6E3F",
                "warning": "#8A4500",
                "warningSoft": "#FFF7E8",
                "warningText": "#8A4500",
                "danger": "#B42318",
                "dangerPressed": "#8A180E",
                "dangerSoft": "#FEF3F2",
                "dangerText": "#B42318",
                "dangerButtonText": "#FFFFFF",
                "dangerPressedText": "#FFFFFF"
            },
            "accent": {
                "purple": "#6941C6",
                "slateIcon": "#64748B"
            },
            "overlay": "rgba(11, 23, 54, 0.45)",
            "controlBorder": "#7A879B",
            "focus": "#0B5ED7"
        },
        "dark": {
            "brand": {
                "primary": "#4D94FF",
                "primaryPressed": "#1D4ED8",
                "primarySoft": "#1E293B",
                "primarySubtle": "#0F172A",
                "primaryText": "#0B1736",
                "primaryPressedText": "#FFFFFF"
            },
            "canvas": "#0B1220",
            "surface": "#111A2B",
            "surfaceMuted": "#172338",
            "text": {
                "primary": "#F8FAFC",
                "secondary": "#C7D2E0",
                "tertiary": "#8A99AD"
            },
            "border": "#1E293B",
            "divider": "#172338",
            "status": {
                "success": "#10B981",
                "successSoft": "#064E3B",
                "successText": "#6EE7B7",
                "warning": "#F59E0B",
                "warningSoft": "#78350F",
                "warningText": "#FDE68A",
                "danger": "#EF4444",
                "dangerPressed": "#B91C1C",
                "dangerSoft": "#7F1D1D",
                "dangerText": "#FCA5A5",
                "dangerButtonText": "#0B1736",
                "dangerPressedText": "#FFFFFF"
            },
            "accent": {
                "purple": "#A48AFB",
                "slateIcon": "#94A3B8"
            },
            "overlay": "rgba(0, 0, 0, 0.70)",
            "controlBorder": "#65758D",
            "focus": "#4D94FF"
        }
    },
    "spacing": {
        "xxs": 4,
        "xs": 8,
        "sm": 12,
        "md": 16,
        "lg": 20,
        "xl": 24,
        "xxl": 32
    },
    "radius": {
        "sm": 10,
        "md": 12,
        "lg": 16,
        "full": 9999,
        "xs": 8,
        "xl": 20,
        "pill": 9999
    },
    "layout": {
        "breakpoints": {
            "compact": 600,
            "medium": 768,
            "expanded": 768,
            "kpiFourColumnsEligible": 900
        },
        "dimensions": {
            "appBarHeight": 56,
            "bottomTabBarHeight": 64,
            "navigationRailWidth": 72,
            "sidebarWidth": 240,
            "kpiCardMin": {
                "width": 120,
                "height": 88
            },
            "listItemMinHeight": 64,
            "searchFieldHeight": 48,
            "inputFieldHeight": 48
        },
        "breakpointPolicy": "compact <600; rail600-767; sidebar>=768. KPI four-column eligibility>=900 requires available content/font-scaled fit; fallback2x2. Logical units, not physical screen orientation."
    },
    "interactive": {
        "minHitTarget": 48,
        "components": {
            "primaryButton": {
                "visualHeight": 48,
                "minHitTarget": 48,
                "radius": 12
            },
            "secondaryButton": {
                "visualHeight": 40,
                "minHitTarget": 48,
                "radius": 12
            },
            "inputField": {
                "visualHeight": 48,
                "minHitTarget": 48,
                "radius": 12
            },
            "searchField": {
                "visualHeight": 48,
                "minHitTarget": 48,
                "radius": 12
            },
            "filterChip": {
                "visualHeight": 32,
                "minHitTarget": 48,
                "radius": 9999
            },
            "iconButton": {
                "visualSize": 40,
                "minHitTarget": 48,
                "radius": 8
            },
            "fab": {
                "visualSize": 56,
                "minHitTarget": 56,
                "radius": 9999
            }
        }
    },
    "shadows": {
        "elevation1": {
            "shadowColor": "#0B1736",
            "shadowOffset": {
                "width": 0,
                "height": 1
            },
            "shadowOpacity": 0.05,
            "shadowRadius": 2,
            "elevation": 1
        },
        "elevation2": {
            "shadowColor": "#0B1736",
            "shadowOffset": {
                "width": 0,
                "height": 4
            },
            "shadowOpacity": 0.08,
            "shadowRadius": 8,
            "elevation": 3
        },
        "elevation3": {
            "shadowColor": "#0B1736",
            "shadowOffset": {
                "width": 0,
                "height": 12
            },
            "shadowOpacity": 0.12,
            "shadowRadius": 16,
            "elevation": 6
        },
        "card": {
            "y": 4,
            "blur": 12,
            "spread": 0,
            "color": "rgba(15, 23, 42, 0.06)"
        },
        "floating": {
            "y": 8,
            "blur": 24,
            "color": "rgba(15, 23, 42, 0.12)"
        }
    },
    "motion": {
        "durationFast": 150,
        "durationNormal": 250,
        "durationSlow": 350,
        "easingDefault": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "zIndex": {
        "fab": 100,
        "dropdown": 200,
        "bottomSheet": 400,
        "modal": 500,
        "toast": 1000
    },
    "iconStrokeWidth": {
        "size24": 2.0,
        "size20": 1.75
    }
}
