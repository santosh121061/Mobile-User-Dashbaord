{
  "name": "user-dashboard-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-dependencies.cjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "check": "npm run test:paths && npm run typecheck && npm run lint && npm test",
    "generate:api": "openapi-typescript api/openapi.json --empty-objects-unknown -o src/api/generated/schema.d.ts",
    "validate:contracts": "node scripts/validate-contracts.cjs",
    "test:paths": "node --test scripts/review-paths.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-application": "~57.0.3",
    "expo-build-properties": "57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "57.0.20",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "1.53.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "ajv": "6.15.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
